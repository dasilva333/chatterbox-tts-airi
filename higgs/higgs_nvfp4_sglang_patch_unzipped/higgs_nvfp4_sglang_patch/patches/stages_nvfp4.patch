+# Conservative default used by config.py.  The standalone file fetched for this
+# patch did not define it, but config.py imports it.
+DEFAULT_MAX_CONCURRENCY = int(os.environ.get("HIGGS_TTS_MAX_CONCURRENCY", "8"))
