+def _looks_like_prepared_nvfp4_checkpoint(checkpoint_dir: str | os.PathLike[str]) -> bool:
+    """Return True when this checkpoint has the prepared ModelOpt FP4 marker.
+
+    The Reza2kn NVFP4 repo ships a descriptive quantization_config.json; this
+    patch's prepare step writes SGLang's expected `quantization_config` into
+    config.json and a sidecar hf_quant_config.json.  This helper lets the Higgs
+    stage pass SGLang's ModelOpt FP4 quantization hint when available, while
+    remaining harmless for the original bf16 checkpoint.
+    """
+    import json
+
+    cfg_path = Path(checkpoint_dir) / "config.json"
+    if not cfg_path.exists():
+        return False
+    try:
+        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
+    except Exception:
+        return False
+    q = cfg.get("quantization_config") or {}
+    return (
+        str(q.get("quant_algo", "")).upper() == "NVFP4"
+        or str(q.get("quant_method", "")).lower() in {"modelopt", "modelopt_fp4"}
+    )
+
+
